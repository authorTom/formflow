# FormFlow — Compose environment template.
#
# Copy this file to ".env" (same directory as compose.yaml) and edit as needed.
# Docker Compose reads a sibling ".env" automatically for ${...} interpolation.
# Real ".env" files are gitignored; only this template is tracked.

# Host port to publish the app on (the container always listens on 8080).
FORMFLOW_PORT=8080

# Image to run. Default is the latest multi-arch build from GHCR.
# Pin an immutable tag for reproducible, rollback-friendly deploys, e.g.:
#   FORMFLOW_IMAGE=ghcr.io/authortom/formflow:sha-fe1d50d
FORMFLOW_IMAGE=ghcr.io/authortom/formflow:latest


# ---- Limits ----------------------------------------------------------------

# Largest file a respondent may attach to a file-upload question, in MB.
FORMFLOW_MAX_UPLOAD_MB=10

# Public write requests (starting a response, saving an answer) allowed per IP
# per minute. Raise it if a single office NAT shares one address.
FORMFLOW_RATE_LIMIT=120


# ---- Sessions and invitations ----------------------------------------------

# How long a sign-in lasts before it expires, in days.
FORMFLOW_SESSION_TTL_DAYS=30

# How long an invitation link stays redeemable, in days. An invitation is
# single-use and only works for the address it was issued to.
FORMFLOW_INVITE_TTL_DAYS=7

# Session cookies are marked Secure automatically when the request arrives over
# HTTPS. Set this to "true" to force it — correct when a TLS-terminating proxy
# forwards to this container over plain HTTP and you never serve it over HTTP.
FORMFLOW_SECURE_COOKIES=false

# X-Forwarded-* headers are trusted by default so rate limiting and the Secure
# cookie flag see the real client. Set to "false" only when nothing sits in
# front of the container.
# FORMFLOW_TRUST_PROXY=true


# ---- Where data lives ------------------------------------------------------
# Inside the container this is /data (a volume — see compose.yaml), holding
# formflow.db and an uploads/ directory. Change it only if you also change the
# volume mount.
# FORMFLOW_DATA_DIR=/data


# ---- A note on accounts ----------------------------------------------------
# This instance is invite-only. Nobody can sign themselves up: administrators
# issue single-use invitation links bound to one email address. The single
# exception is a brand-new instance with no accounts at all, where the first
# person to register becomes the administrator — so claim that account before
# exposing the port.
#
# Forms belong to groups rather than to individuals, and default to requiring a
# sign-in to fill in. A group manager can open a form to anyone with the link,
# in which case its responses are anonymous.
#
# Locked out of the last administrator account? On the host holding the data
# directory:  npm run set-password -- you@example.com 'a new passphrase' --admin
